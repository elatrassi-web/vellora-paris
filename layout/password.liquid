<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700&family=Poppins:wght@300;400&display=swap" rel="stylesheet">

    <title>{{ shop.name }}</title>

    <meta name="description" content="Mot de passe requis pour accéder à {{ shop.name }}">

    {{ content_for_header }}

    <style>
      :root {
        --color-primary: {{ settings.color_primary }};
        --color-secondary: {{ settings.color_secondary }};
        --color-text-secondary: {{ settings.color_text_secondary }};
        --color-border: {{ settings.color_border }};
        --color-background: {{ settings.color_background }};
        --font-heading: 'Montserrat', sans-serif;
        --font-body: 'Poppins', sans-serif;
      }
      body {
        margin: 0;
        font-family: var(--font-body);
        background-color: var(--color-background);
        color: var(--color-primary);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .password-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
      }
    </style>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="password">
    <main id="MainContent" class="password-main focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
