<div class="customer-account">
  <div class="container">
    <div class="account-header fade-up">
      <h1>Mon Compte</h1>
      <a href="{{ routes.account_logout_url }}" class="link-underline">Se déconnecter</a>
    </div>

    <div class="account-layout fade-up" style="animation-delay: 0.2s;">

      <!-- Order History -->
      <div class="account-orders">
        <h2>Historique des commandes</h2>

        {% paginate customer.orders by 20 %}
          {%- if customer.orders.size > 0 -%}
            <table role="table" class="order-history">
              <thead role="rowgroup">
                <tr role="row">
                  <th id="ColumnOrder" scope="col" role="columnheader">Commande</th>
                  <th id="ColumnDate" scope="col" role="columnheader">Date</th>
                  <th id="ColumnPayment" scope="col" role="columnheader">Paiement</th>
                  <th id="ColumnFulfillment" scope="col" role="columnheader">Statut</th>
                  <th id="ColumnTotal" scope="col" role="columnheader">Total</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {%- for order in customer.orders -%}
                  <tr role="row">
                    <td id="RowOrder" role="cell" headers="ColumnOrder" data-label="Commande">
                      <a href="{{ order.customer_url }}" aria-label="Commande {{ order.name }}">{{ order.name }}</a>
                    </td>
                    <td headers="RowOrder ColumnDate" role="cell" data-label="Date">
                      {{ order.created_at | time_tag: format: 'date' }}
                    </td>
                    <td headers="RowOrder ColumnPayment" role="cell" data-label="Paiement">
                      {{ order.financial_status_label }}
                    </td>
                    <td headers="RowOrder ColumnFulfillment" role="cell" data-label="Statut">
                      {{ order.fulfillment_status_label }}
                    </td>
                    <td headers="RowOrder ColumnTotal" role="cell" data-label="Total">
                      {{ order.total_price | money_with_currency }}
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p>Vous n'avez pas encore passé de commande.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline" style="margin-top:20px;">DÉCOUVRIR LA COLLECTION</a>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <div class="pagination">
              {{ paginate | default_pagination }}
            </div>
          {%- endif -%}
        {% endpaginate %}
      </div>

      <!-- Account Details -->
      <div class="account-details">
        <h2>Détails du compte</h2>

        <div class="account-details__card">
          <p><strong>{{ customer.name }}</strong></p>
          {{ customer.default_address | format_address }}
          <a href="{{ routes.account_addresses_url }}" class="btn btn--outline" style="margin-top: 20px; width:100%;">GÉRER LES ADRESSES ({{ customer.addresses_count }})</a>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .customer-account {
    padding: 80px 0;
  }
  .account-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 20px;
  }
  .account-header h1 {
    margin: 0;
    font-size: 2rem;
    letter-spacing: 2px;
  }

  .account-layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media screen and (min-width: 1024px) {
    .account-layout {
      flex-direction: row;
      align-items: flex-start;
    }
    .account-orders { width: 65%; }
    .account-details { width: 35%; }
  }

  .account-layout h2 {
    font-size: 1.2rem;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  /* Table styles */
  .order-history {
    width: 100%;
    border-collapse: collapse;
  }
  .order-history th {
    text-align: left;
    padding: 10px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }
  .order-history td {
    padding: 15px 10px;
    border-bottom: 1px solid var(--color-border);
  }
  .order-history td a {
    font-weight: bold;
    text-decoration: underline;
  }

  @media screen and (max-width: 767px) {
    .order-history thead { display: none; }
    .order-history tr { display: block; margin-bottom: 20px; border: 1px solid var(--color-border); padding: 10px; }
    .order-history td { display: flex; justify-content: space-between; border: none; padding: 5px 0; }
    .order-history td::before {
      content: attr(data-label);
      font-weight: bold;
      color: var(--color-text-secondary);
    }
  }

  .account-details__card {
    background: #f9f9f9;
    padding: 30px;
    border: 1px solid var(--color-border);
  }
  .account-details__card p {
    margin-bottom: 10px;
  }
</style>
