<div class="brands-grid" data-section-id="{{ section.id }}">
  <div class="container">
    <h2 class="brands-grid__title fade-up">NOS MARQUES PARTENAIRES</h2>
    <div class="brands-grid__wrapper">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="brands-grid__item fade-up" style="animation-delay: {{ forloop.index | times: 0.1 }}s">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 400x | image_tag: loading: 'lazy', alt: block.settings.title }}
          {% else %}
            <div class="brands-grid__placeholder">{{ block.settings.title }}</div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .brands-grid {
    padding: 60px 0;
    background-color: var(--color-background);
  }
  .brands-grid__title {
    text-align: center;
    font-size: 1.5rem;
    letter-spacing: 2px;
    margin-bottom: 40px;
  }
  .brands-grid__wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media screen and (min-width: 1024px) {
    .brands-grid__wrapper {
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
    }
  }
  .brands-grid__item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    border: 1px solid transparent;
    transition: all 0.3s ease;
    filter: grayscale(100%);
    opacity: 0.7;
  }
  .brands-grid__item:hover {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
    border-color: var(--color-border);
  }
  .brands-grid__item img {
    max-height: 80px;
    width: auto;
  }
  .brands-grid__placeholder {
    font-family: var(--font-heading);
    font-weight: bold;
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }
</style>

{% schema %}
{
  "name": "Grille de Marques",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo de la marque"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nom (si pas d'image)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien vers la collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grille de Marques",
      "category": "Image",
      "blocks": [
        { "type": "brand", "settings": { "title": "Prada" } },
        { "type": "brand", "settings": { "title": "Asics" } },
        { "type": "brand", "settings": { "title": "New Balance" } },
        { "type": "brand", "settings": { "title": "Loewe" } },
        { "type": "brand", "settings": { "title": "Chanel" } },
        { "type": "brand", "settings": { "title": "Fred" } },
        { "type": "brand", "settings": { "title": "Lunettes Premium" } }
      ]
    }
  ]
}
{% endschema %}
