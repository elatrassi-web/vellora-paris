<div class="brands-marquee" data-section-id="{{ section.id }}">
  <div class="brands-marquee__track">
    <!-- First set of logos -->
    {% for block in section.blocks %}
      {% if block.settings.image != blank %}
        <a href="{{ block.settings.link }}" class="brands-marquee__item">
          {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Brand logo' }}
        </a>
      {% endif %}
    {% endfor %}

    <!-- Duplicate set of logos to create the infinite seamless loop -->
    {% for block in section.blocks %}
      {% if block.settings.image != blank %}
        <a href="{{ block.settings.link }}" class="brands-marquee__item" aria-hidden="true">
          {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Brand logo' }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .brands-marquee {
    padding: 60px 0;
    background-color: var(--color-background);
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
  }
  .brands-marquee::before,
  .brands-marquee::after {
    content: '';
    position: absolute;
    top: 0;
    width: 150px;
    height: 100%;
    z-index: 2;
  }
  .brands-marquee::before {
    left: 0;
    background: linear-gradient(to right, var(--color-background) 0%, transparent 100%);
  }
  .brands-marquee::after {
    right: 0;
    background: linear-gradient(to left, var(--color-background) 0%, transparent 100%);
  }

  .brands-marquee__track {
    display: inline-flex;
    align-items: center;
    gap: 80px; /* Space between logos */
    padding-left: 80px;
    animation: scrollMarquee 25s linear infinite;
  }

  .brands-marquee__track:hover {
    animation-play-state: paused;
  }

  .brands-marquee__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    filter: grayscale(100%);
    opacity: 0.6;
  }

  .brands-marquee__item:hover {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }

  .brands-marquee__item img {
    max-height: 50px;
    width: auto;
    object-fit: contain;
  }

  @keyframes scrollMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Shifts exactly 50% of the track width (one full set of logos) */
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 768px) {
    .brands-marquee__item img {
      max-height: 40px;
    }
    .brands-marquee__track {
      gap: 50px;
      padding-left: 50px;
    }
    .brands-marquee::before,
    .brands-marquee::after {
      width: 50px;
    }
  }
</style>

{% schema %}
{
  "name": "Bande de Marques",
  "max_blocks": 15,
  "settings": [
    {
      "type": "paragraph",
      "content": "Ajoutez des blocs avec des images pour créer un carrousel infini de logos. Les textes ne seront pas affichés."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo de la marque"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien vers la collection (Optionnel)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bande de Marques (Roulette)",
      "category": "Image"
    }
  ]
}
{% endschema %}
