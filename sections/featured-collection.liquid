<div class="featured-collection" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="featured-collection__header fade-up">
      <h2>{{ section.settings.title | default: 'NOUVEAUTÉS' }}</h2>
      {% assign view_all_link = '/collections/all' %}
      {% if section.settings.collection != blank %}
        {% assign view_all_link = collections[section.settings.collection].url %}
      {% endif %}
      <a href="{{ view_all_link }}" class="link-underline">VOIR TOUT</a>
    </div>

    <div class="featured-collection__filters fade-up">
      <button class="filter-btn is-active" data-filter="all">Tout</button>
      <button class="filter-btn" data-filter="vêtements">Vêtements</button>
      <button class="filter-btn" data-filter="sneakers">Sneakers</button>
      <button class="filter-btn" data-filter="accessoires">Accessoires</button>
      <button class="filter-btn" data-filter="lunettes">Lunettes</button>
    </div>

    <div class="featured-collection__slider-wrapper fade-up">
      <button class="slider-nav slider-nav--prev" aria-label="Précédent" onclick="scrollSlider(-1)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="featured-collection__slider-container" id="featured-slider">
        <div class="featured-collection__track">
          {% assign products_to_show = blank %}

          {% if section.settings.collection != blank %}
          {% assign products_to_show = collections[section.settings.collection].products %}
        {% else %}
          {% assign products_to_show = collections['all'].products | sort: 'created_at' | reverse %}
        {% endif %}

        {% for product in products_to_show limit: 12 %}
          {% assign product_tags_string = product.tags | join: ' ' | downcase %}
          {% assign product_categories = product.type | downcase | append: ' ' | append: product_tags_string %}
          <div class="product-card js-filtered-product" data-categories="{{ product_categories }}">
            <a href="{{ product.url }}" class="product-card__image-wrapper">
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}" class="product-card__image">
              {% if product.images.size > 1 %}
                <img src="{{ product.images[1] | img_url: '600x' }}" alt="{{ product.title }} back" class="product-card__image-hover">
              {% endif %}

              {% if product.tags contains 'Nouveau' %}
                <span class="product-card__badge">NOUVEAU</span>
              {% endif %}

              <div class="product-card__auth-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Authentique Vérifié
              </div>

              <button class="product-card__quick-view" onclick="event.preventDefault(); openQuickView('{{ product.handle }}')">VOIR LE PRODUIT</button>
            </a>
            <div class="product-card__info">
              <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="product-card__price">{{ product.price | money }}</p>
            </div>
          </div>
        {% else %}
          {% for i in (1..4) %}
            <div class="product-card">
              <div class="product-card__image-wrapper" style="background:var(--color-border); aspect-ratio: 3/4;"></div>
              <div class="product-card__info">
                <h3 class="product-card__title">Produit Exemple</h3>
                <p class="product-card__price">199,00 €</p>
              </div>
            </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>

      <button class="slider-nav slider-nav--next" aria-label="Suivant" onclick="scrollSlider(1)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .featured-collection {
    padding: 60px 0;
    overflow: hidden;
  }
  .featured-collection__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
  }
  .featured-collection__filters {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    scrollbar-width: none;
    margin-bottom: 30px;
    padding-bottom: 5px;
  }
  .featured-collection__filters::-webkit-scrollbar { display: none; }
  .filter-btn {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: color 0.3s ease;
    padding-bottom: 5px;
    border-bottom: 2px solid transparent;
  }
  .filter-btn:hover, .filter-btn.is-active {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .featured-collection h2 {
    font-size: 1.5rem;
    margin: 0;
    letter-spacing: 2px;
  }
  .link-underline {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: bold;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .featured-collection__slider-wrapper {
    position: relative;
  }
  .slider-nav {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    width: 44px;
    height: 44px;
    display: none; /* Hidden on mobile by default, swipe is better */
    align-items: center;
    justify-content: center;
    z-index: 10;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: all 0.3s;
  }
  .slider-nav:hover {
    background: var(--color-primary);
    color: var(--color-background);
  }
  .slider-nav--prev { left: -22px; }
  .slider-nav--next { right: -22px; }

  @media screen and (min-width: 1024px) {
    .slider-nav { display: flex; }
  }

  .featured-collection__slider-container {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
    scroll-snap-type: x mandatory;
    padding-bottom: 20px;
    scroll-behavior: smooth;
  }
  .featured-collection__slider-container::-webkit-scrollbar {
    display: none;
  }
  .featured-collection__track {
    display: flex;
    gap: 20px;
    width: max-content;
  }
  .product-card {
    width: 280px;
    scroll-snap-align: start;
  }
  @media screen and (min-width: 768px) {
    .product-card { width: 320px; }
  }
  .product-card__image-wrapper {
    position: relative;
    display: block;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: var(--color-border);
    margin-bottom: 15px;
  }
  .product-card__image,
  .product-card__image-hover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }
  .product-card__image-hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  .product-card__image-wrapper:hover .product-card__image {
    opacity: 0;
  }
  .product-card__image-wrapper:hover .product-card__image-hover {
    opacity: 1;
    transform: scale(1.1);
  }
  /* Fallback hover effect if only one image exists */
  .product-card__image-wrapper:hover img:only-child {
    opacity: 1;
    transform: scale(1.1);
  }
  .product-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: var(--color-primary);
    color: var(--color-background);
    font-size: 0.7rem;
    font-weight: bold;
    padding: 4px 8px;
    z-index: 2;
    animation: pulse 2s infinite;
  }
  .product-card__auth-badge {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.9);
    color: #1a1a1a;
    font-size: 0.7rem;
    font-weight: bold;
    padding: 6px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    z-index: 2;
    text-transform: uppercase;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
  .product-card__auth-badge svg {
    color: #2e7d32; /* Green check */
  }
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  .product-card__quick-view {
    position: absolute;
    bottom: -50px;
    left: 0;
    width: 100%;
    background-color: rgba(255,255,255,0.9);
    color: var(--color-primary);
    padding: 15px 0;
    font-weight: bold;
    text-align: center;
    transition: bottom 0.3s ease;
    z-index: 2;
  }
  .product-card__image-wrapper:hover .product-card__quick-view {
    bottom: 0;
  }
  .product-card__info {
    text-align: center;
  }
  .product-card__title {
    font-size: 1rem;
    font-weight: normal;
    margin-bottom: 5px;
    font-family: var(--font-body);
  }
  .product-card__price {
    font-weight: bold;
    font-size: 1.1rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const products = document.querySelectorAll('.js-filtered-product');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all buttons
        filterBtns.forEach(b => b.classList.remove('is-active'));
        // Add active class to clicked button
        btn.classList.add('is-active');

        const filterValue = btn.getAttribute('data-filter');

        products.forEach(product => {
          if (filterValue === 'all') {
            product.style.display = 'block';
          } else {
            const categories = product.getAttribute('data-categories');
            if (categories.includes(filterValue)) {
              product.style.display = 'block';
            } else {
              product.style.display = 'none';
            }
          }
        });

        // Reset scroll position when filtering
        const slider = document.getElementById('featured-slider');
        if(slider) slider.scrollLeft = 0;
      });
    });
  });

  function scrollSlider(direction) {
    const slider = document.getElementById('featured-slider');
    if (!slider) return;

    // Calculate scroll amount based on first visible card width + gap
    let cardWidth = 320; // fallback default
    const visibleCards = Array.from(slider.querySelectorAll('.product-card')).filter(card => card.style.display !== 'none');
    if (visibleCards.length > 0) {
      cardWidth = visibleCards[0].offsetWidth;
    }

    const gap = 20; // Matches gap in .featured-collection__track
    const scrollAmount = cardWidth + gap;

    slider.scrollBy({
      left: scrollAmount * direction,
      behavior: 'smooth'
    });
  }
</script>

{% schema %}
{
  "name": "Collection Vedette",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Collection Vedette",
      "category": "Collection"
    }
  ]
}
{% endschema %}
