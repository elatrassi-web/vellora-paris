<div class="password-page">
  <div class="password-header">
    <h1 class="password-logo">VELLORA PARIS</h1>
  </div>

  <div class="password-content fade-up">
    <h2>BIENTÔT DISPONIBLE</h2>
    <p>Notre boutique ouvrira très prochainement. Inscrivez-vous pour être informé de notre lancement exclusif.</p>

    {% form 'customer', class: 'password-newsletter' %}
      <input type="hidden" name="contact[tags]" value="prospect, password page">

      {% if form.posted_successfully? %}
        <div class="form-status-list form__message" style="color: green; margin-bottom: 15px;">
          Merci pour votre inscription ! Nous vous contacterons bientôt.
        </div>
      {% else %}
        <div class="newsletter-input-group">
          <input type="email" name="contact[email]" id="Email" placeholder="Votre adresse email" autocorrect="off" autocapitalize="off" required>
          <button type="submit" name="commit" class="btn btn--submit">S'INSCRIRE</button>
        </div>
      {% endif %}
    {% endform %}
  </div>

  <div class="password-login">
    <p class="password-login-toggle" onclick="togglePasswordForm()">Accès administrateur / Possédez-vous un mot de passe ?</p>

    <div id="password-form-container" style="display: none; margin-top: 20px;">
      {% form 'storefront_password', class: 'password-form' %}
        {{ form.errors | default_errors }}
        <div class="newsletter-input-group">
          <input type="password" name="password" id="Password" placeholder="Mot de passe" autofocus>
          <button type="submit" name="commit" class="btn btn--submit">ENTRER</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<style>
  .password-page {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    padding: 40px 20px;
  }
  .password-logo {
    font-size: 3rem;
    letter-spacing: 4px;
    margin-bottom: 60px;
    font-family: var(--font-heading);
    text-transform: uppercase;
  }
  .password-content h2 {
    font-size: 2rem;
    margin-bottom: 20px;
  }
  .password-content p {
    color: var(--color-text-secondary);
    margin-bottom: 40px;
    line-height: 1.6;
  }
  .newsletter-input-group {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 60px;
  }
  @media screen and (min-width: 768px) {
    .newsletter-input-group {
      flex-direction: row;
      gap: 0;
    }
    .newsletter-input-group input {
      flex: 1;
      border-right: none;
    }
    .newsletter-input-group button {
      width: auto;
    }
  }
  .newsletter-input-group input {
    padding: 15px 20px;
    border: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 1rem;
    outline: none;
  }
  .password-login {
    border-top: 1px solid var(--color-border);
    padding-top: 40px;
    margin-top: 40px;
  }
  .password-login-toggle {
    font-size: 0.9rem;
    text-decoration: underline;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: color 0.3s;
  }
  .password-login-toggle:hover {
    color: var(--color-primary);
  }
</style>

<script>
  function togglePasswordForm() {
    const formContainer = document.getElementById('password-form-container');
    if (formContainer.style.display === 'none') {
      formContainer.style.display = 'block';
      document.getElementById('Password').focus();
    } else {
      formContainer.style.display = 'none';
    }
  }
</script>

{% schema %}
{
  "name": "Page Mot de Passe",
  "settings": []
}
{% endschema %}
