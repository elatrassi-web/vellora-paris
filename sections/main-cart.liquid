<div class="cart-page" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="cart__header fade-up">
      <h1>VOTRE PANIER</h1>
      <a href="/collections/all" class="link-underline">Continuer les achats</a>
    </div>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" novalidate class="cart__form fade-up">
        <div class="cart__layout">

          <!-- Cart Items -->
          <div class="cart__items">
            <div class="cart__items-header d-none d-lg-grid">
              <span>Produit</span>
              <span>Quantité</span>
              <span>Total</span>
            </div>

            {% for item in cart.items %}
              <div class="cart-item">
                <div class="cart-item__product">
                  <a href="{{ item.url }}" class="cart-item__image">
                    {{ item.image | image_url: width: 200x | image_tag: loading: 'lazy', alt: item.title }}
                  </a>
                  <div class="cart-item__details">
                    {% if item.vendor %}
                      <p class="cart-item__vendor">{{ item.vendor }}</p>
                    {% endif %}
                    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                    {% unless item.variant.title contains 'Default' %}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {% endunless %}
                    <p class="cart-item__price d-lg-none">{{ item.price | money }}</p>
                    <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="cart-item__remove">Supprimer</a>
                  </div>
                </div>

                <div class="cart-item__quantity">
                  <div class="qty-selector">
                    <button type="button" onclick="updateCartQty('{{ item.key }}', -1, this)">-</button>
                    <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" data-key="{{ item.key }}" onchange="document.querySelector('.cart__form').submit()">
                    <button type="button" onclick="updateCartQty('{{ item.key }}', 1, this)">+</button>
                  </div>
                </div>

                <div class="cart-item__total d-none d-lg-block">
                  {{ item.final_line_price | money }}
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Cart Summary -->
          <div class="cart__summary">
            <h3>RÉSUMÉ</h3>

            <div class="cart__summary-row">
              <span>Sous-total</span>
              <span class="cart__subtotal">{{ cart.total_price | money }}</span>
            </div>

            <div class="cart__summary-shipping">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>LIVRAISON GRATUITE DANS LE MONDE ENTIER</span>
            </div>

            <p class="cart__tax-note">Les taxes et codes promotionnels seront calculés à l'étape de paiement.</p>

            <div class="cart__summary-row cart__summary-total">
              <span>Total</span>
              <span class="cart__total">{{ cart.total_price | money }}</span>
            </div>

            <button type="submit" name="checkout" class="btn btn--checkout">PASSER LA COMMANDE</button>

            <div class="cart__trust">
              <div class="cart__payment-icons">
                {% for type in shop.enabled_payment_types %}
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                {% endfor %}
              </div>
              <p>Paiement 100% Sécurisé</p>
            </div>
          </div>

        </div>
      </form>
    {% else %}
      <!-- Empty Cart -->
      <div class="cart__empty fade-up">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-border)" stroke-width="1"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <h2>VOTRE PANIER EST VIDE</h2>
        <p>Découvrez notre sélection de marques premium.</p>
        <a href="/collections/all" class="btn">DÉCOUVRIR LA COLLECTION</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .cart-page {
    padding: 60px 0 100px;
  }
  @media screen and (min-width: 1024px) {
    .cart-page { padding-top: 120px; } /* Sticky header offset */
  }
  .cart__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 20px;
  }
  .cart__header h1 {
    margin: 0;
    font-size: 2rem;
  }

  .cart__layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media screen and (min-width: 1024px) {
    .cart__layout {
      flex-direction: row;
      align-items: flex-start;
    }
    .cart__items { width: 65%; }
    .cart__summary { width: 35%; position: sticky; top: 100px; }
  }

  /* Items */
  .cart__items-header {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 20px;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 0.9rem;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }
  @media screen and (min-width: 1024px) {
    .cart-item {
      grid-template-columns: 3fr 1fr 1fr;
      align-items: center;
    }
  }
  .cart-item__product {
    display: flex;
    gap: 20px;
  }
  .cart-item__image {
    width: 100px;
    height: 120px;
    background: var(--color-border);
    flex-shrink: 0;
  }
  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-item__vendor {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .cart-item__title {
    font-weight: bold;
    font-size: 1.1rem;
    display: block;
    margin-bottom: 5px;
  }
  .cart-item__variant {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: 10px;
  }
  .cart-item__remove {
    font-size: 0.8rem;
    text-decoration: underline;
    color: var(--color-text-secondary);
  }

  .qty-selector {
    display: flex;
    border: 1px solid var(--color-primary);
    width: 132px;
  }
  .qty-selector button {
    width: 44px;
    height: 44px;
    font-size: 1.2rem;
  }
  .qty-selector input {
    width: 44px;
    height: 44px;
    text-align: center;
    border: none;
    font-weight: bold;
    -moz-appearance: textfield;
  }
  .qty-selector input::-webkit-outer-spin-button,
  .qty-selector input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-item__total {
    font-weight: bold;
    font-size: 1.1rem;
    text-align: right;
  }

  /* Summary */
  .cart__summary {
    background: #f9f9f9;
    padding: 30px;
  }
  .cart__summary h3 {
    font-size: 1.2rem;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 10px;
  }
  .cart__summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .cart__summary-total {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
    font-size: 1.4rem;
  }
  .cart__summary-shipping {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-background);
    border: 1px solid var(--color-primary);
    padding: 15px;
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .cart__tax-note {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-bottom: 20px;
    text-align: center;
  }
  .btn--checkout {
    width: 100%;
    margin-bottom: 20px;
  }
  .cart__trust {
    text-align: center;
  }
  .cart__payment-icons {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .cart__payment-icons svg {
    width: 38px;
    height: 24px;
  }
  .cart__trust p {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  /* Empty */
  .cart__empty {
    text-align: center;
    padding: 60px 0;
  }
  .cart__empty svg {
    margin-bottom: 20px;
  }
  .cart__empty h2 {
    margin-bottom: 10px;
  }
  .cart__empty p {
    color: var(--color-text-secondary);
    margin-bottom: 30px;
  }
</style>

<script>
  function updateCartQty(key, change, btn) {
    const input = btn.parentElement.querySelector('input');
    let val = parseInt(input.value) + change;
    if (val < 0) val = 0;
    input.value = val;
    // Debounce submit or submit immediately
    document.querySelector('.cart__form').submit();
  }
</script>

{% schema %}
{
  "name": "Page Panier",
  "settings": []
}
{% endschema %}
