<div class="product-reviews" style="padding: 40px 0; border-top: 1px solid var(--color-border); margin-top: 40px;">
  <div class="container">
    <h2 style="text-align: center; margin-bottom: 30px; font-size: 1.5rem; text-transform: uppercase;">Avis clients</h2>
    <div id="shopify-product-reviews" data-id="{{product.id}}">{{ product.metafields.spr.reviews }}</div>
    <p style="text-align: center; color: var(--color-text-secondary); font-size: 0.9rem;">(Avis gérés via l'application native Shopify Reviews ou code HTML statique à intégrer ici)</p>
  </div>
</div>

{% schema %}
{
  "name": "Avis Clients",
  "settings": [],
  "presets": [
    {
      "name": "Avis Clients"
    }
  ]
}
{% endschema %}
