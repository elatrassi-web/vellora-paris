<div class="search-page">
  <div class="container">
    <div class="search__header fade-up">
      <h1>RÉSULTATS DE RECHERCHE</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Rechercher des marques, vêtements..."
        >
        <button type="submit" class="btn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    </div>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="search__empty fade-up">
          <p>Aucun résultat ne correspond à votre recherche pour "{{ search.terms }}".</p>
          <p>Essayez avec d'autres mots-clés ou découvrez nos nouveautés.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline mt-4">VOIR TOUT LE CATALOGUE</a>
        </div>
      {% else %}
        <div class="search__results fade-up">
          <p class="search__count">{{ search.results_count }} résultats trouvés</p>

          <div class="product-grid">
            {% paginate search.results by 12 %}
              {% for item in search.results %}
                {% if item.object_type == 'product' %}
                  <div class="product-card">
                    <a href="{{ item.url }}" class="product-card__image-wrapper">
                      <img src="{{ item.featured_image | img_url: '600x' }}" alt="{{ item.title }}" class="product-card__image">

                      <!-- Auth badge if applicable -->
                      <div class="product-card__auth-badge">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        Authentique Vérifié
                      </div>

                      <button class="product-card__quick-view" onclick="event.preventDefault(); openQuickView('{{ item.handle }}')">VUE RAPIDE</button>
                    </a>
                    <div class="product-card__info">
                      {% if item.vendor %}
                        <p class="product-card__vendor" style="font-size:0.8rem;text-transform:uppercase;color:var(--color-text-secondary);font-weight:bold;">{{ item.vendor }}</p>
                      {% endif %}
                      <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      <p class="product-card__price">{{ item.price | money }}</p>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}

              {% if paginate.pages > 1 %}
                <div class="pagination">
                  {{ paginate | default_pagination }}
                </div>
              {% endif %}
            {% endpaginate %}
          </div>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

<style>
  .search-page {
    padding: 80px 0;
    min-height: 60vh;
  }
  .search__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 60px;
  }
  .search__header h1 {
    font-size: 2rem;
    margin-bottom: 30px;
    letter-spacing: 2px;
  }
  .search__form {
    display: flex;
    border: 2px solid var(--color-primary);
  }
  .search__form input {
    flex: 1;
    border: none;
    padding: 15px;
    font-size: 1.1rem;
    font-family: var(--font-body);
    outline: none;
  }
  .search__form button {
    border: none;
    padding: 0 20px;
    min-width: auto;
  }

  .search__empty {
    text-align: center;
    color: var(--color-text-secondary);
  }
  .search__count {
    margin-bottom: 30px;
    color: var(--color-text-secondary);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media screen and (min-width: 768px) {
    .product-grid { grid-template-columns: repeat(3, 1fr); gap: 30px; }
  }
  @media screen and (min-width: 1024px) {
    .product-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .mt-4 { margin-top: 30px; }
</style>

{% schema %}
{
  "name": "Résultats de recherche"
}
{% endschema %}

<style>
  .product-card__auth-badge {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.9);
    color: #1a1a1a;
    font-size: 0.7rem;
    font-weight: bold;
    padding: 6px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    z-index: 2;
    text-transform: uppercase;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
  .product-card__auth-badge svg {
    color: #2e7d32;
  }
</style>
