<div id="mini-cart" class="mini-cart" aria-hidden="true">
  <div class="mini-cart__overlay" onclick="closeMiniCart()"></div>
  <div class="mini-cart__drawer">
    <div class="mini-cart__header">
      <h3>Mon Panier</h3>
      <button class="mini-cart__close" onclick="closeMiniCart()" aria-label="Fermer le panier">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="mini-cart__content">
      <div id="mini-cart-items-container">
        <!-- Cart items will be dynamically injected here -->
        <div class="mini-cart__empty-message">Votre panier est vide</div>
      </div>
    </div>
    <div class="mini-cart__footer">
      <div class="mini-cart__subtotal">
        <span>Sous-total</span>
        <span class="mini-cart__subtotal-price">0,00 €</span>
      </div>
      <p class="mini-cart__shipping-msg">Livraison gratuite dans le monde entier</p>
      <a href="/cart" class="btn btn--outline">Voir le panier</a>
      <a href="/checkout" class="btn">Commander</a>
    </div>
  </div>
</div>

<style>
  .mini-cart {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    pointer-events: none;
    visibility: hidden;
  }
  .mini-cart.is-open {
    pointer-events: auto;
    visibility: visible;
  }
  .mini-cart__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mini-cart.is-open .mini-cart__overlay {
    opacity: 1;
  }
  .mini-cart__drawer {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 400px;
    height: 100%;
    background: var(--color-background);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    flex-direction: column;
  }
  .mini-cart.is-open .mini-cart__drawer {
    transform: translateX(0);
  }
  .mini-cart__header {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }
  .mini-cart__content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }
  .mini-cart__footer {
    padding: 20px;
    border-top: 1px solid var(--color-border);
  }
  .mini-cart__subtotal {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
    margin-bottom: 10px;
  }
  .mini-cart__shipping-msg {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-bottom: 20px;
  }
  .mini-cart__footer .btn {
    width: 100%;
    margin-bottom: 10px;
  }
</style>

<script>
  function openMiniCart() {
    document.getElementById('mini-cart').classList.add('is-open');
    document.body.style.overflow = 'hidden';
    updateMiniCartContent();
  }

  // Hook for Add to Cart shake animation
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('form[action="/cart/add"]').forEach(form => {
      form.addEventListener('submit', (e) => {
        const cartIcon = document.querySelector('button[aria-label="Panier"] svg');
        if (cartIcon) {
          cartIcon.classList.add('animate-shake');
          setTimeout(() => {
            cartIcon.classList.remove('animate-shake');
          }, 500);
        }
      });
    });
  });

  function closeMiniCart() {
    document.getElementById('mini-cart').classList.remove('is-open');
    document.body.style.overflow = '';
  }

  function updateMiniCartContent() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const container = document.getElementById('mini-cart-items-container');
        const subtotalEl = document.querySelector('.mini-cart__subtotal-price');
        const countEls = document.querySelectorAll('.header__icon-count:not(#wishlist-count)');

        // Update counts
        countEls.forEach(el => el.textContent = cart.item_count);

        // Update subtotal
        subtotalEl.textContent = (cart.total_price / 100).toFixed(2).replace('.', ',') + ' €';

        if (cart.item_count === 0) {
          container.innerHTML = '<div class="mini-cart__empty-message" style="text-align:center; margin-top:20px;">Votre panier est vide</div>';
          return;
        }

        let html = '';
        cart.items.forEach((item, index) => {
          html += `
            <div style="display:flex; gap:15px; margin-bottom:20px; border-bottom:1px solid var(--color-border); padding-bottom:15px;">
              <a href="${item.url}" style="width:80px; height:100px; flex-shrink:0;">
                <img src="${item.image}" alt="${item.title}" style="width:100%; height:100%; object-fit:cover;">
              </a>
              <div style="flex:1; display:flex; flex-direction:column;">
                <a href="${item.url}" style="font-weight:bold; font-size:0.9rem; margin-bottom:5px;">${item.product_title}</a>
                ${item.variant_title ? `<span style="font-size:0.8rem; color:var(--color-text-secondary); margin-bottom:5px;">${item.variant_title}</span>` : ''}
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto;">
                  <span style="font-weight:bold;">${(item.price / 100).toFixed(2).replace('.', ',')} €</span>
                  <div style="display:flex; border:1px solid var(--color-border); width:80px;">
                    <button onclick="changeMiniCartQty(${index + 1}, ${item.quantity - 1})" style="width:25px; padding:2px;">-</button>
                    <span style="flex:1; text-align:center; padding:2px;">${item.quantity}</span>
                    <button onclick="changeMiniCartQty(${index + 1}, ${item.quantity + 1})" style="width:25px; padding:2px;">+</button>
                  </div>
                </div>
                <button onclick="changeMiniCartQty(${index + 1}, 0)" style="align-self:flex-start; margin-top:10px; font-size:0.8rem; text-decoration:underline; color:var(--color-text-secondary);">Supprimer</button>
              </div>
            </div>
          `;
        });
        container.innerHTML = html;
      });
  }

  function changeMiniCartQty(line, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, quantity: quantity })
    })
    .then(response => response.json())
    .then(cart => {
      updateMiniCartContent();
      // If we're on the cart page, reload it to reflect changes there too
      if (window.location.pathname === '/cart') {
        window.location.reload();
      }
    });
  }
</script>
